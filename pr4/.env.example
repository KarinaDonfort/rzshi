# Скопіюйте цей файл у .env і впишіть свій ключ — або скопіюйте готовий
# .env із папки pr3 і допишіть до нього рядки, яких там немає.
# Файл .env до репозиторію не потрапляє — ключ доступу є секретом.

# Для офіційного Gemini SDK базовий URL не потрібен. Модель викликається
# через google-genai, а не через OpenAI-сумісний compatibility layer.
LLM_BASE_URL=

# Ключ із Google AI Studio: https://aistudio.google.com → Get API key
LLM_API_KEY=

# Назва моделі. Перелік доступних дивіться в Google AI Studio —
# назви змінюються з виходом нових версій.
LLM_MODEL=gemini-3.5-flash-lite

# Параметри генерації. Структурованій відповіді потрібен запас на поля,
# тому max_tokens більший, ніж у ПР3.
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=600

# Скільки секунд чекати на відповідь, перш ніж перервати запит.
LLM_TIMEOUT=30

# Бюджет токенів на весь запит без відповіді: інструкція, правила,
# історія, звернення. Відправна точка, а не рекомендація: чим його
# рахувати і що скорочувати, коли він вичерпаний, — ваше рішення.
LLM_TOKEN_BUDGET=3000
